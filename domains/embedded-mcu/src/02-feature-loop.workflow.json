  "cards": [
    {
      "dot": "emerald",
      "title": "Luật của vòng lặp",
      "items": [
        "Mỗi vòng chỉ một tính năng, diff nhỏ nhất; doc viết cùng code và duyệt cùng merge",
        "planner vẽ sơ đồ module bằng archify; builder chạy gitnexus impact trước khi sửa một hàm",
        "Cổng tự động (build, host test, ngân sách bộ nhớ, cppcheck/MISRA một phần) chạy trước reviewer",
        "Chỉ verifier được kết luận PASS; BLOCKED không bao giờ thành PASS"
      ]
    },
    {
      "dot": "cyan",
      "title": "Chính sách HIL và OTA",
      "items": [
        "HIL bắt buộc khi đổi driver, ISR, power, boot/OTA; bench bận thì BLOCKED, người duyệt quyết",
        "OTA theo đợt: nhóm nhỏ trước, mở rộng khi telemetry ổn",
        "Crash, reboot hoặc dòng tiêu thụ xấu đi: rollback về firmware trước, mở thay đổi mới cho builder"
      ]
    },
    {
      "dot": "rose",
      "title": "Đường quay lại",
      "items": [
        "Lỗi build/test, vượt ngân sách bộ nhớ, vi phạm tĩnh, review yêu cầu sửa, FAIL đều về builder",
        "Tối đa 3 vòng; quá giới hạn thì chuyển cho người"
      ]
    },
    {
      "dot": "amber",
      "title": "Tri thức khép vòng",
      "items": [
        "curator biến crash và telemetry thành dấu hiệu lỗi đã biết (chuỗi log → nguyên nhân)",
        "Lần sau planner nạp lại decisions và lỗi đã biết từ Khối 1"
      ]
    }
  ]
}