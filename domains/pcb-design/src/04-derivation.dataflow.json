  "cards": [
    {
      "dot": "emerald",
      "title": "Đầu ra không được cũ hơn nguồn",
      "items": [
        "Mỗi file dẫn xuất ghi derived_from: file nguồn và hash của nó",
        "Manifest rev liệt kê nguồn và đầu ra; nguồn đổi mà đầu ra chưa sinh lại thì verifier trả FAIL",
        "DRC --schematic-parity kiểm layout khớp schematic; hash kiểm Gerber khớp layout"
      ]
    },
    {
      "dot": "amber",
      "title": "Sinh ra, rồi sửa tay",
      "items": [
        "BOM và pin map sinh từ schematic rồi bổ sung tay (linh kiện thay thế, DNP, tên tín hiệu cho firmware)",
        "Phần sửa tay nằm ở file riêng hoặc trường riêng, để sinh lại không xoá mất",
        "Gerber, PnP, STEP chỉ sinh ra: agent không sửa tay, chỉ sinh lại bằng jobset"
      ]
    },
    {
      "dot": "cyan",
      "title": "Artefact chung giữa domain",
      "items": [
        "Pin map, power tree: pcb-design sở hữu, embedded-mcu đọc; đổi cần người duyệt của cả hai",
        "Biên board, lỗ vít: mechanical-design sở hữu, pcb-design đọc; STEP board đi ngược lại để kiểm va chạm",
        "Tồn kho, giá không lưu thành file: tra lúc dùng, kết quả kiểm ghi kèm ngày"
      ]
    }
  ]
}
