  "cards": [
    {
      "dot": "cyan",
      "title": "Khối 1 · Tri thức nhúng",
      "items": [
        "Datasheet, errata, TRM, SVD: chỉ trích xuất (grep) kèm số trang, không tóm tắt",
        "Sách và kiến trúc tham chiếu: chưng cất thành skill",
        "Tiêu chuẩn bật theo mức an toàn trong domain.toml; chỉ giữ mã quy tắc + diễn giải tự viết",
        "Tri thức nội bộ gồm cả dấu hiệu lỗi đã biết, cập nhật từ crash và telemetry hiện trường"
      ]
    },
    {
      "dot": "violet",
      "title": "Khối 2 · Agent & công cụ",
      "items": [
        "archify: vẽ kiến trúc và luồng làm đầu vào cho thiết kế",
        "gitnexus: phân tích ảnh hưởng trước khi sửa một hàm",
        "Phân tích tĩnh: cppcheck, chỉ phủ một phần MISRA C",
        "HIL bench: chạy theo chính sách, đo cả dòng ngủ cho ngân sách pin",
        "ponytail là kỷ luật viết code của builder (skill), không phải cổng kiểm chứng"
      ]
    },
    {
      "dot": "emerald",
      "title": "Khối 3 · Workflow",
      "items": [
        "Agent điều phối đọc CLAUDE.md, giao việc cho vòng lặp",
        "Vòng lặp: spec → duyệt → code + doc → cổng tự động → review → HIL (khi cần) → merge",
        "Merge chưa phải kết thúc: OTA theo đợt và telemetry quyết giữ hay rollback"
      ]
    },
    {
      "dot": "amber",
      "title": "Khối 4 · Mô hình hoá domain",
      "items": [
        "Domain Pack khai báo: nguồn tri thức, mức an toàn, công cụ, các bước kiểm chứng",
        "Lúc sinh: new_project.py chép core + overlay một lần; lúc chạy agent chỉ đọc file trong repo",
        "Bài học đúng ở ≥ 2 dự án được đề xuất lên pack, người duyệt mới nhận",
        "Đổi domain = đổi pack; agent điều phối và vòng lặp giữ nguyên"
      ]
    }
  ]
