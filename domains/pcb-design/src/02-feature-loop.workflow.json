  "cards": [
    {
      "dot": "emerald",
      "title": "Khác domain phần mềm ở đâu",
      "items": [
        "Kiểm chứng thật (board thật) mất nhiều tuần và tiền: mọi kiểm tra rẻ phải xong trước khi đặt hàng",
        "Ba lần thực hiện nối tiếp: schematic, placement, routing; mỗi lần có cổng riêng và đổi về sau đắt dần",
        "Không rollback được: lỗi nhỏ thì rework trên board, lỗi lớn thì làm rev mới"
      ]
    },
    {
      "dot": "cyan",
      "title": "Ba cổng người duyệt",
      "items": [
        "Chốt schematic: baseline; sau đó đổi linh kiện hay kết nối là phải làm lại layout",
        "Duyệt placement: stackup, nhiệt, EMC, biên và lỗ bắt vít (cùng kỹ sư cơ khí) được quyết ở đây, trước khi routing",
        "Chốt gửi sản xuất: duyệt gói Gerber/IPC-2581, BOM, giá, thời gian giao; trả lời EQ của nhà máy cũng là quyết định của người"
      ]
    },
    {
      "dot": "violet",
      "title": "Kiểm BOM hai lần",
      "items": [
        "Lần 1 lúc chốt schematic: vòng đời (NRND/EOL), số nguồn, linh kiện thay thế, khi layout còn đổi được",
        "Lần 2 trong gói sản xuất: tồn kho, lead time, giá theo số lượng; hết hàng thì BLOCKED, người quyết đổi linh kiện, chờ hay ký deviation"
      ]
    },
    {
      "dot": "rose",
      "title": "Đường quay lại",
      "items": [
        "ERC/BOM lỗi về builder schematic; placement bị từ chối về builder placement; DRC vi phạm và review yêu cầu sửa về builder routing",
        "Bring-up FAIL: lỗi sửa được thì rework và ghi nhật ký theo serial; lỗi lớn thì curator mở ECO, rev mới bắt đầu lại từ planner (sơ đồ 03)"
      ]
    }
  ]
